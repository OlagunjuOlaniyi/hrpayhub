        $("#annualCycle").addClass("d-none");
      } else {
        $("#kpiCycle").addClass("d-none");
        $("#annualCycle").removeClass("d-none");
      }
    }

    // Initial call on load
    toggleSalaryView();

    // Bind change event to radio buttons
    $("input[name='starter']").change(toggleSalaryView);
  });
</script>
