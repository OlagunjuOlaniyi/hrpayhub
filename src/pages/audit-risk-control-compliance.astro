---
import Layout from "../layouts/Layout.astro";
---

<Layout title="HRPayHub :: Audit, Risk, Control & Compliance">
  <!-- Main content starts here -->
  <main>
    <!-- First section of Back button and Breadcrumb -->
    <section class="p-4">
      <div class="screenFrame">
        <!-- Back Navigation button and BreadCrumbs -->
        <div class="d-flex gap-5">
          <a
            href="index.html"
            title="Back to Dashboard"
            class="d-flex gap-2 align-items-center text-decoration-none text-primary-dark"
          >
            <img src="images/png/icons/angle-left.svg" alt="angle-left-back" />
            <span class="fs-16 fw-bold font-avenir-bold">Back</span>
          </a>

          <!-- Actual Breadcrumb here -->
          <div class="d-flex align-items-center gap-2">
            <a
              href="index.html"
              class="fs-14 text-decoration-none text-primary-dark">Dashboard</a
            >
            <img
              src="images/png/icons/angle-right.svg"
              alt="angle-right-back"
            />
            <span class="fs-16 fw-bold text-primary-blue"
              >Audit, Risk, Control & Compliance</span
            >
          </div>
          <!-- Actual Breadcrumb here -->
        </div>
        <!-- Back Navigation button and BreadCrumbs -->
      </div>
    </section>
    <!-- First section of Back button and Breadcrumb -->

    <!-- First section of Back button and Breadcrumb -->
    <section class="px-4">
      <div class="screenFrame">
        <div class="rounded-4 shadow p-4 vstack gap-5 px-5">
          {/* Page Title */}
          <div class="vstack gap-2">
            <div class="d-flex gap-3 align-items-center">
              <img
                src="images/png/icons/appraisal.svg"
                alt="receipt-minus-icon"
                width="30px"
                height="30px"
              />
              <span
                class="text-primary-blue font-ubuntu-bold fs-24 inline-block"
                >Audit, Risk, Control & Compliance
              </span>
            </div>
            <div class="fw-bold">
              Manage audits, risks, controls, compliance, findings, actions, and
              AI reports.
            </div>
          </div>
          {/* Page Title */}

          {/* Page Content Box */}
          <div class="row payslip-grid-gap mb-5">
            {
              [
                {
                  title: "Audit Dashboard",
                  desc: "View audit, risk, control, and action status",
                  url: "/audit-dashboard",
                },
                {
                  title: "Audit Universe",
                  desc: "Define auditable areas across the business",
                  url: "/audit-universe",
                },
                {
                  title: "Enterprise Risk Register",
                  desc: "Track risks, scores, owners, controls, and plans.",
                  url: "/enterprise-risk-register",
                },
                {
                  title: "Risk-Based Audit Planning",
                  desc: "Plan audits based on risk and priority",
                  url: "/risk-based-audit-planning",
                },
                {
                  title: "Audit Program & Checklist",
                  desc: "Create audit programs, tests, and checklists",
                  url: "/audit-program-checklist",
                },
                {
                  title: "Audit Execution",
                  desc: "Perform audits and record observations",
                  url: "/audit-execution",
                },
                {
                  title: "Workpaper & Evidence",
                  desc: "Manage workpapers, evidence, and reviews",
                  url: "/workpaper-and-evidence",
                },
                {
                  title: "Control Library",
                  desc: "Manage internal controls and ownership",
                  url: "/control-library",
                },
                {
                  title: "Control Testing",
                  desc: "Test control design and eKectiveness",
                  url: "/control-testing",
                },
                {
                  title: "Workpaper & Evidence",
                  desc: "Manage workpapers, evidence, and reviews",
                  url: "/workpaper-and-evidence",
                },
                {
                  title: "Findings & Issues",
                  desc: "Record findings, root causes, and impact",
                  url: "/findings-and-issues",
                },
                {
                  title: "Corrective Actions",
                  desc: "Assign, track, verify, and close actions",
                  url: "/corrective-actions",
                },
                {
                  title: "Compliance Register",
                  desc: "Track obligations, deadlines, and evidence",
                  url: "/compliance-register",
                },
                {
                  title: "Policy Tracking",
                  desc: "Manage policies, reviews, and acknowledgements",
                  url: "/policy-tracking",
                },
                {
                  title: "Audit Reports",
                  desc: "Generate audit, risk, and control reports",
                  url: "/audit-reports",
                },
                {
                  title: "Executive Reports",
                  desc: "View board-level risk and audit summaries",
                  url: "/executive-reports",
                },
                {
                  title: "Audit Logs",
                  desc: "Track all audit, risk, and control changes",
                  url: "/audit-logs",
                },
                {
                  title: "Access Configuration",
                  desc: "Configure audit, risk, control, and report permissions",
                  url: "/access-configuration",
                },
              ].map((ele) => (
                <div
                  class="col-4 p-2 payslip-card-panel"
                  style="width: 350px;"
                  role="button"
                  title={ele.title}
                  data-url={ele.url}
                >
                  <div
                    class="shadow p-3 px-3 rounded-3 d-flex flex-column align-items-center justify-content-start gap-3 text-center"
                    style="height: 168px"
                  >
                    <div class=" gap-2 d-flex flex-column align-items-center">
                      <img
                        src="images/png/icons/appraisal.svg"
                        alt="receipt-minus-icon"
                        width="30px"
                        height="30px"
                      />
                      <div class="fw-bold fs-18 font-ubuntu-bold text-primary-blue">
                        {ele.title}
                      </div>
                    </div>

                    <div
                      class="fw-600 fs-16"
                      style="width: 98%; margin: 0 auto;"
                    >
                      {ele.desc}
                    </div>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>
  </main>
  <!-- Main content ends here -->

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const payslipCardPanels = document.querySelectorAll(
        ".payslip-card-panel",
      );

      payslipCardPanels.forEach((ele, index) => {
        ele?.addEventListener("click", (e) => {
          const url = ele.getAttribute("data-url") || "";
          const title = ele.getAttribute("title") || "";
          window.open(url, title);
        });
      });
    });
  </script>
</Layout>
