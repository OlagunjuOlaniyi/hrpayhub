---
import Layout from "../layouts/Layout.astro";

import { Naira, Pounds } from "../components/Symbols";
---

<Layout title="HRPayHub :: Control Dashboard">
  <!-- Main content starts here -->
  <main>
    <!-- First section of Back button and Breadcrumb -->
    <section class="p-4">
      <div class="screenFrame">
        <!-- Back Navigation button and BreadCrumbs -->
        <div class="d-flex gap-5">
          <a
            href="/internal-control-management"
            title="Back to Dashboard"
            class="d-flex gap-2 align-items-center text-decoration-none text-primary-dark"
          >
            <img src="images/png/icons/angle-left.svg" alt="angle-left-back" />
            <span class="fs-16 fw-bold font-avenir-bold">Back</span>
          </a>

          <!-- Actual Breadcrumb here -->
          <div class="d-flex align-items-center gap-2">
            <a
              href="index.html"
              class="fs-14 text-decoration-none text-primary-dark">Dashboard</a
            >
            <img
              src="images/png/icons/angle-right.svg"
              alt="angle-right-back"
            />
            <a
              href="/audit-risk-control-compliance"
              class="fs-14 text-decoration-none text-primary-dark"
              >Audit, Risk, Control & Compliance</a
            >

            <img
              src="images/png/icons/angle-right.svg"
              alt="angle-right-back"
            />
            <a
              href="/internal-control-management"
              class="fs-14 text-decoration-none text-primary-dark"
              >Internal Control Management</a
            >
            <img
              src="images/png/icons/angle-right.svg"
              alt="angle-right-back"
            />
            <span class="fs-16 fw-bold text-primary-blue"
              >Control Dashboard</span
            >
          </div>
          <!-- Actual Breadcrumb here -->
        </div>
        <!-- Back Navigation button and BreadCrumbs -->
      </div>
    </section>
    <!-- First section of Back button and Breadcrumb -->

    <!-- First section of Back button and Breadcrumb -->
    <section class="px-4">
      <div class="screenFrame">
        <div class="rounded-4 shadow p-4 vstack gap-5 px-4">
          {/* Page Content Box */}
          <div class="p-lg-2">
            <div class="vstack px-5" style="gap: 2.3rem">
              <div class="d-flex justify-content-between gap-3">
                <div>
                  <div class="fw-700 fs-22">Control Dashboard</div>
                  <div class="fs-14">
                    Monitor controls, tests, failures, evidence, and
                    remediation.
                  </div>
                </div>
              </div>

              <div class="d-flex justify-content-between">
                <div
                  class="d-flex flex-column gap-2 py-4 px-4 border rounded-4"
                  style="width: 398px;"
                >
                  <div class="d-flex justify-content-between">
                    <div>
                      <h1 class="fs-14 fw-600">Total Controls</h1>
                    </div>
                  </div>

                  <div class="d-flex gap-2">
                    <span
                      class="fw-700 border border-1 rounded-3 p-2 fs-14"
                      style="background-color: #2271B633; color: #2271B6; height: fit-content"
                      role="button">1</span
                    >
                  </div>
                </div>
                <div
                  class="d-flex flex-column gap-2 py-4 px-4 border rounded-4"
                  style="width: 398px;"
                >
                  <div class="d-flex justify-content-between">
                    <div>
                      <h1 class="fs-14 fw-600">Corrective Controls</h1>
                    </div>
                  </div>

                  <div class="d-flex gap-2">
                    <span
                      class="fw-700 border border-1 rounded-3 p-2 fs-14"
                      style="background-color: #FFF5F5; color: #FD0000; height: fit-content"
                      role="button">0</span
                    >
                  </div>
                </div>
                <div
                  class="d-flex flex-column gap-2 py-4 px-4 border rounded-4"
                  style="width: 398px;"
                >
                  <div class="d-flex justify-content-between">
                    <div>
                      <h1 class="fs-14 fw-600">Controls Due for Testing</h1>
                    </div>
                  </div>

                  <div class="d-flex gap-2">
                    <span
                      class="fw-700 border border-1 rounded-3 p-2 fs-14"
                      style="background-color: #FFF5F5; color: #FD0000; height: fit-content"
                      role="button">0</span
                    >
                  </div>
                </div>
              </div>
              <div class="d-flex justify-content-between">
                <div
                  class="d-flex flex-column gap-2 py-4 px-4 border rounded-4"
                  style="width: 398px;"
                >
                  <div class="d-flex justify-content-between">
                    <div>
                      <h1 class="fs-14 fw-600">Passed Controls</h1>
                    </div>
                  </div>

                  <div class="d-flex gap-2">
                    <span
                      class="fw-700 border border-1 rounded-3 p-2 fs-14"
                      style="background-color: #FFF5F5; color: #FD0000; height: fit-content"
                      role="button">0</span
                    >
                  </div>
                </div>
                <div
                  class="d-flex flex-column gap-2 py-4 px-4 border rounded-4"
                  style="width: 398px;"
                >
                  <div class="d-flex justify-content-between">
                    <div>
                      <h1 class="fs-14 fw-600">Controls Without Owners</h1>
                    </div>
                  </div>

                  <div class="d-flex gap-2">
                    <span
                      class="fw-700 border border-1 rounded-3 p-2 fs-14"
                      style="background-color: #FFF5F5; color: #FD0000; height: fit-content"
                      role="button">0</span
                    >
                  </div>
                </div>
                <div
                  class="d-flex flex-column gap-2 py-4 px-4 border rounded-4"
                  style="width: 398px;"
                >
                  <div class="d-flex justify-content-between">
                    <div>
                      <h1 class="fs-14 fw-600">Remediation Due This Week</h1>
                    </div>
                  </div>

                  <div class="d-flex gap-2">
                    <span
                      class="fw-700 border border-1 rounded-3 p-2 fs-14"
                      style="background-color: #FFF5F5; color: #FD0000; height: fit-content"
                      role="button">0</span
                    >
                  </div>
                </div>
              </div>
              <div class="d-flex justify-content-between">
                <div
                  class="d-flex flex-column gap-2 py-4 px-4 border rounded-4"
                  style="width: 398px;"
                >
                  <div class="d-flex justify-content-between">
                    <div>
                      <h1 class="fs-14 fw-600">Overdue Remediation</h1>
                    </div>
                  </div>

                  <div class="d-flex gap-2">
                    <span
                      class="fw-700 border border-1 rounded-3 p-2 fs-14"
                      style="background-color: #FFF5F5; color: #FD0000; height: fit-content"
                      role="button">0</span
                    >
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <!-- Main content ends here -->
    </section>

    <script is:inline>
      document.addEventListener("DOMContentLoaded", () => {
        const ctx2 = document.getElementById("pieChart");
        if (!ctx2 || typeof Chart === "undefined") return;

        new Chart(ctx2, {
          type: "pie",
          data: {
            labels: [
              "Strategic",
              "Operational",
              "Financial",
              "Compliance",
              "Fraud",
            ],
            datasets: [
              {
                data: [25, 30, 18, 10, 10],
                backgroundColor: ["#FDBA8C", "#2271B6", "#18C1C8"],
                borderWidth: 1,
              },
            ],
          },
          options: {
            responsive: false,
            plugins: {
              legend: {
                display: false, // we use custom legend
              },
              tooltip: {
                callbacks: {
                  label: (ctx2) =>
                    `${ctx2.label}: ${ctx2.raw.toLocaleString()}`,
                },
              },
            },
          },
        });
      });
    </script>
  </main>
</Layout>
