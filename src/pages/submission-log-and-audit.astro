---
import Layout from "../layouts/Layout.astro";
import PaymentPostModal from "../components/ui/PaymentPostModal.astro";
import ApplicantTrackingModal from "../components/ui/ApplicantTrackingModal.astro";
import ModalAddNew from "../components/ui/ModalAddNew.astro";
import DeleteModal from "../components/ui/DeleteModal.astro";
import ModalAddNew2 from "../components/ui/ModalAddNew2.astro";
---

<Layout title="HRPayHub :: Submission Log & Audit  ">
  <!-- Main content starts here -->
  <main>
    <!-- First section of Back button and Breadcrumb -->
    <section class="p-4">
      <div class="screenFrame">
        <!-- Back Navigation button and BreadCrumbs -->
        <div class="d-flex gap-5">
          <a
            href="/rti-submission"
            title="Back to Dashboard"
            class="d-flex gap-2 align-items-center text-decoration-none text-primary-dark"
          >
            <img src="images/png/icons/angle-left.svg" alt="angle-left-back" />
            <span class="fs-16 fw-bold font-avenir-bold">Back</span>
          </a>

          <!-- Actual Breadcrumb here -->
          <div class="d-flex align-items-center gap-2">
            <a
              href="index.html"
              class="fs-14 text-decoration-none text-primary-dark">Dashboard</a
            >
            <img
              src="images/png/icons/angle-right.svg"
              alt="angle-right-back"
            />
            <a
              href="/rti-submission"
              class="fs-14 text-decoration-none text-primary-dark"
              >RTI Submission</a
            >

            <img
              src="images/png/icons/angle-right.svg"
              alt="angle-right-back"
            />
            <span class="fs-16 fw-bold text-primary-blue"
              >Submission Log & Audit
            </span>
          </div>
          <!-- Actual Breadcrumb here -->
        </div>
        <!-- Back Navigation button and BreadCrumbs -->
      </div>
    </section>
    <!-- First section of Back button and Breadcrumb -->

    <!-- First section of Back button and Breadcrumb -->
    <section class="px-lg-5">
      <div class="screenFrame">
        <div class="rounded-4 shadow p-5 vstack gap-3 px-lg-5">
          {/* Page Title */}
          <div class="d-flex justify-content-between gap-3">
            <div>
              <div class="fw-700 fs-22">Submission Log & Audit</div>
              <div class="fs-14">
                Keep detailed RTI submission logs for audits.
              </div>
            </div>
          </div>
          {/* Page Title */}

          <div class="d-flex flex-column gap-4 py-3 px-4 border rounded-4 mt-3">
            <!-- Nav pills -->
            <div class="d-flex gap-4 mt-4">
              <div class="d-flex gap-3">
                <input
                  type="text"
                  class="form-control search-input search-width fs-14"
                  placeholder="Search..."
                />
              </div>
            </div>

            <!-- Scrollable Table -->
            <div
              class="table-responsive mt-3"
              style="max-height: 600px; overflow: auto;"
            >
              <table class="table table-bordered table-hover">
                <!---- Table head --->
                <thead class="bg-grey text-dark px-4 fw-700 fs-14 text-nowrap">
                  <tr>
                    <th class="bg-grey text-darktext-white px-3 fw-700 fs-14"
                      >S/N</th
                    >
                    <th class="bg-grey text-darktext-white px-3 fw-700 fs-14"
                      >Timestamp</th
                    >
                    <th class="bg-grey text-darktext-white px-3 fw-700 fs-14"
                      >User</th
                    >
                    <th class="bg-grey text-darktext-white px-3 fw-700 fs-14">
                      Action</th
                    >
                    <th
                      class="bg-grey text-dark fw-700 fs-14 px-3 text-left"
                      style="min-width: 200px;">Description</th
                    >
                  </tr>
                </thead>
                <tbody>
                  <!-- Table body and Row -->
                  <style>
                    .column {
                      min-width: 180px;
                    }
                  </style>
                  {
                    [
                      {
                        client_name: "29/10/2025, 10:14:00",
                        client_email: "Patricia Moore",
                        phone_no: "23rd Oct, 2025",
                        currency: "RTI Submitted",
                        pay_terms: "FPS-2026-07 submitted to HMRC.",
                        status: "Submitted",
                        out_bal: "Internal",
                        notes: "Lorem Ipsum...",
                        modalId: "hiredModal",
                      },
                      {
                        client_name: "29/10/2025, 10:14:00",
                        client_email: "Patricia Moore",
                        phone_no: "23rd Oct, 2025",
                        currency: "RTI Submitted",
                        pay_terms: "Cash",
                        status: "Submitted",
                        out_bal: "Internal",
                        notes: "Lorem Ipsum...",
                        modalId: "hiredModal",
                      },
                      {
                        client_name: "29/10/2025, 10:14:00",
                        client_email: "Patricia Moore",
                        phone_no: "23rd Oct, 2025",
                        currency: "RTI Submitted",
                        pay_terms: "POS",
                        status: "Pending",
                        out_bal: "Internal",
                        notes: "Lorem Ipsum...",
                        modalId: "newModal",
                      },
                      {
                        client_name: "29/10/2025, 10:14:00",
                        client_email: "Patricia Moore",
                        phone_no: "23rd Oct, 2025",
                        currency: "RTI Submitted",
                        pay_terms: "FPS-2026-07 submitted to HMRC.",
                        status: "Pending",
                        out_bal: "Internal",
                        notes: "Lorem Ipsum...",
                        modalId: "offeredModal",
                      },
                      {
                        client_name: "29/10/2025, 10:14:00",
                        client_email: "Patricia Moore",
                        phone_no: "23rd Oct, 2025",
                        currency: "RTI Submitted",
                        pay_terms: "FPS-2026-07 submitted to HMRC.",
                        status: "Error",
                        out_bal: "Internal",
                        notes: "Lorem Ipsum...",
                        modalId: "rejectedModal",
                      },

                      {
                        client_name: "29/10/2025, 10:14:00",
                        client_email: "Patricia Moore",
                        phone_no: "23rd Oct, 2025",
                        currency: "RTI Submitted",
                        pay_terms: "FPS-2026-07 submitted to HMRC.",
                        status: "Error",
                        out_bal: "Internal",
                        notes: "Lorem Ipsum...",
                        modalId: "rejectedModal",
                      },
                    ].map((ele, index) => (
                      <tr class="fs-88">
                        <td class="fs-14 text-center">{index + 1}</td>

                        <td class="fs-14 px-3 text-left column">
                          {ele.client_name}
                        </td>
                        <td class="fs-14 text-nowrap px-3 text-left column">
                          {ele.client_email}
                        </td>
                        <td class="fs-14 px-3 text-left column">
                          {ele.currency}
                        </td>
                        <td class="fs-14 px-3 text-left column">
                          {ele.pay_terms}
                        </td>
                      </tr>
                    ))
                  }

                  <!-- Repeat for more employees -->
                </tbody>
              </table>
            </div>
          </div>

          {/* Page Content Box */}

          {/* Page Content Box */}
          <!-- Pagination Row -->
          <div
            class="d-flex justify-content-between align-items-center m-2 flex-wrap gap-3 pt-3"
          >
            <!-- Left: Pagination Text -->
            <div class="fs-14 text-muted">
              Showing <strong>1–20</strong> of <strong>1000</strong>
            </div>

            <!-- Right: Go to Page + Pagination -->
            <div class="d-flex align-items-center gap-3 flex-wrap">
              <!-- Go to Page -->
              <form class="d-flex align-items-center gap-2">
                <label for="gotoPage" class="fs-14 mb-0">Go to page?</label>
                <input
                  type="number"
                  min="1"
                  max="100"
                  id="gotoPage"
                  class="form-control form-control-sm"
                  style="width: 60px;"
                  placeholder="—"
                />
              </form>

              <!-- Page Navigation -->

              <nav>
                <ul class="pagination pagination-sm mb-0 text-primary-blue">
                  <li class="page-item">
                    <a
                      class="page-link text-primary-blue px-2"
                      href="#"
                      aria-label="Previous"
                    >
                      &lsaquo;
                    </a>
                  </li>
                  <li class="page-item">
                    <a class="page-link text-primary-blue" href="#">1</a>
                  </li>
                  <li class="page-item active" aria-current="page">
                    <span class="page-link">2</span>
                  </li>
                  <li class="page-item">
                    <a class="page-link text-primary-blue" href="#">3</a>
                  </li>
                  <li class="page-item disabled">
                    <span class="page-link text-primary-blue">...</span>
                  </li>
                  <li class="page-item">
                    <a class="page-link text-primary-blue" href="#">100</a>
                  </li>
                  <li class="page-item">
                    <a class="page-link hello" href="#" aria-label="Next">
                      &rsaquo;
                    </a>
                  </li>
                </ul>
              </nav>
            </div>
          </div>

          <!---- Pagination ---->
        </div>
      </div>
    </section>

    <ModalAddNew
      modalId="myModal"
      title={"Employer Onboarding"}
      inputPlace="Employer Onboarding"
    />
  </main>
</Layout>

<!-- Main content ends here -->

<script></script>
