                    type="button"
                    data-bs-toggle="dropdown"
                    aria-expanded="false"
                    data-bs-offset="-20,10"
                  >
                    <img src="images/png/icons/sort.svg" alt="arrow-down" />
                    <span>Sort</span>
                  </button>
                  <div
                    class="dropdown-menu p-0 border-0"
                    style="min-width:200px"
                  >
                    <ul class="list-group border-0 fw-600 fs-14">
                      <li class="list-group-item">
                        <span class="fw-bold">Sort</span>
                      </li>
                      <li class="list-group-item">
                        <label class="form-check-label">
                          <input
                            type="radio"
                            class="form-check-input"
                            name="optradio"
                          /> Alphabetically
                        </label>
                      </li>
                      <li class="list-group-item">
                        <label class="form-check-label">
                          <input
                            type="radio"
                            class="form-check-input"
                            name="optradio"
                          /> Date of Resumption
                        </label>
                      </li>
                      <li class="list-group-item">
                        <label class="form-check-label">
                          <input
                            type="radio"
                            class="form-check-input"
                            name="optradio"
                          /> Date of Confirmation
                        </label>
                      </li>
                    </ul>
                  </div>
                </div>
                <!-- Download Dropdown -->
                <div class="dropdown">
                  <button
                    class="delon-primary-btn bg-primary-blue border-0 text-white fw-600 fs-14 dropdown-toggle dropdown-no-arrow d-flex align-items-center gap-2"
                    type="button"
                    data-bs-toggle="dropdown"
                    aria-expanded="false"
                    data-bs-offset="-20,10"
                  >
                    <img src="images/png/icons/download.svg" alt="arrow-down" />
                    <span>Action</span>
                    <img
                      src="images/png/icons/arrow-down.svg"
                      alt="arrow-down"
                    />
                  </button>
                  <div class="dropdown-menu p-0 border-0">
                    <ul class="list-group border-0 fw-600 fs-14">
                      <li class="list-group-item">
                        <div>Download PDF</div>
                      </li>
                      <li class="list-group-item">
                        <div>Print</div>
                      </li>
                      <li class="list-group-item">
                        <div>Email</div>
                      </li>
                    </ul>
                  </div>
                </div>
              </div>

