                      Period</th
                    >
                    <th
                      class="bg-grey text-dark fw-700 fs-14 px-3 text-left"
                      style="min-width: 200px;">Description</th
                    >
                  </tr>
                </thead>
                <tbody>
                  <!-- Table body and Row -->
                  <style>
                    .column {
                      min-width: 180px;
                    }
                  </style>
