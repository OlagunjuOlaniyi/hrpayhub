import DeleteModal from "../components/ui/DeleteModal.astro";
import ModalAddNew2 from "../components/ui/ModalAddNew2.astro";
---

<Layout title="HRPayHub :: P60 Year-End Forms uk ">
  <!-- Main content starts here -->
  <main>
    <!-- First section of Back button and Breadcrumb -->
    <section class="p-4">
      <div class="screenFrame">
        <!-- Back Navigation button and BreadCrumbs -->
        <div class="d-flex gap-5">
          <a
            href="/rti-submission"
            title="Back to Dashboard"
            class="d-flex gap-2 align-items-center text-decoration-none text-primary-dark"
          >
            <img src="images/png/icons/angle-left.svg" alt="angle-left-back" />
            <span class="fs-16 fw-bold font-avenir-bold">Back</span>
          </a>

          <!-- Actual Breadcrumb here -->
          <div class="d-flex align-items-center gap-2">
            <a
              href="index.html"
              class="fs-14 text-decoration-none text-primary-dark">Dashboard</a
            >
            <img
              src="images/png/icons/angle-right.svg"
              alt="angle-right-back"
            />
            <a
              href="/rti-submission"
              class="fs-14 text-decoration-none text-primary-dark"
              >RTI Submission</a
            >

            <img
              src="images/png/icons/angle-right.svg"
              alt="angle-right-back"
            />
            <span class="fs-16 fw-bold text-primary-blue"
              >P60 Year-End Forms uk
            </span>
          </div>
          <!-- Actual Breadcrumb here -->
        </div>
        <!-- Back Navigation button and BreadCrumbs -->
      </div>
    </section>
    <!-- First section of Back button and Breadcrumb -->

    <!-- First section of Back button and Breadcrumb -->
    <section class="px-lg-5">
      <div class="screenFrame">
        <div class="rounded-4 shadow p-5 vstack gap-3 px-lg-5">
          {/* Page Title */}
          <div class="d-flex justify-content-between gap-3">
            <div>
              <div class="fw-700 fs-22">P60 Year-End Forms uk</div>
              <div class="fs-14">
                Generate, view, and manage P60 forms for employees in one place.
              </div>
            </div>
          </div>
          {/* Page Title */}

          <div class="d-flex flex-column gap-4 py-3 px-4 border rounded-4 mt-3">
            <!-- Nav pills -->
            <div class="d-flex justify-content-between gap-4 mt-4">
              <div class="d-flex gap-3">
                <input
                  type="text"
                  class="form-control search-input search-width fs-14"
                  placeholder="Search..."
                />
                <img
                  src="images/png/icons/initialize.svg"
                  class="initialize"
                  alt="arrow-down"
                />
              </div>

              <!-- Others -->
              <div class="responsive gap-3">
                <!-- Calendar Selector -->
                <input
                  type="month"
                  class="form-control fs-14"
                  style="max-width: 200px;"
                  value="2026-08"
                />
                <!-- Filter Dropdown -->

                <style>
                  .dropdown-submenu {
                    position: relative;
                  }

                  /* Accordion style: drop below, not to the right */
                  .dropdown-submenu > .dropdown-menu {
                    position: static;
                    float: none;
                    margin-top: 0.5rem;
                    padding-left: 1rem;
                    display: none;
                  }

                  .dropdown-submenu > .dropdown-menu.show {
                    display: block;
                  }

                  /* a small caret indicator */
                  .dropdown-submenu > a::after {
                    content: " ";
                    float: right;
                  }
                </style>

                <div class="dropdown">
                  <button
                    class="delon-primary-btn bg-white border dropdown-toggle dropdown-no-arrow d-flex align-items-center gap-2 fs-14"
                    type="button"
                    data-bs-toggle="dropdown"
                    data-bs-offset="-20,10"
                  >
                    <img src="images/png/icons/filter.svg" alt="arrow-down" />
                    <span>Filter</span>
                  </button>
                  <ul class="dropdown-menu" style="min-width:250px">
                    <li
                      class="d-flex flex-row justify-content-between px-3 py-2 border-bottom fs-14"
                    >
                      <span class="fw-bold">Filter</span>
                      <span class="fw-bold text-primary-blue">Reset Filter</span
                      >
                    </li>
                    <!-- Designation Submenu -->
                    <li class="dropdown-submenu border-bottom">
                      <a class="dropdown-item dropdown-toggle fs-14" href="#"
                        >Designation</a
                      >
                      <ul class="dropdown-menu border-0 fs-14">
                        <li>
                          <label class="form-check-label">
                            <input
                              type="checkbox"
                              class="form-check-input"
                              name="category 1"
                            /> Category 1
                          </label>
                        </li>
                        <li>
                          <label class="form-check-label">
                            <input
                              type="checkbox"
                              class="form-check-input"
                              name="category 2"
                            /> Category 2
                          </label>
                        </li>
                        <li>
                          <label class="form-check-label">
                            <input
                              type="checkbox"
                              class="form-check-input"
                              name="category 2"
                            /> Category 2
                          </label>
                        </li>
                      </ul>
                    </li>

                    <!-- Employment Status Submenu -->
                    <li class="dropdown-submenu border-bottom">
                      <a class="dropdown-item dropdown-toggle fs-14" href="#"
                        >Employment Status</a
                      >
                      <ul class="dropdown-menu border-0 fs-14">
                        <li>
                          <label class="form-check-label">
                            <input
                              type="checkbox"
                              class="form-check-input"
                              name="employed"
                            /> Employed
                          </label>
                        </li>
                        <li>
                          <label class="form-check-label">
                            <input
                              type="checkbox"
                              class="form-check-input"
                              name="unemployed"
                            /> Unemployed
                          </label>
                        </li>

                        <li>
                          <label class="form-check-label">
                            <input
                              type="checkbox"
                              class="form-check-input"
                              name="contract"
                            /> Contract
                          </label>
                        </li>
                      </ul>
                    </li>

                    <!-- Country of Work Submenu -->
                    <li class="dropdown-submenu border-bottom">
                      <a class="dropdown-item dropdown-toggle fs-14" href="#"
                        >Country of Work</a
                      >
                      <ul class="dropdown-menu border-0 fs-14">
                        <li>
                          <label class="form-check-label">
                            <input
                              type="checkbox"
                              class="form-check-input"
                              name="usa"
                            /> USA
                          </label>
                        </li>
                        <li>
                          <label class="form-check-label">
                            <input
                              type="checkbox"
                              class="form-check-input"
                              name="uk"
                            /> UK
                          </label>
                        </li>
                        <li>
                          <label class="form-check-label">
                            <input
                              type="checkbox"
                              class="form-check-input"
                              name="Nigeria"
                            /> Nigeria
                          </label>
                        </li>
                      </ul>
                    </li>

                    <!-- apply filter button -->
                    <li
                      class="d-flex flex-row justify-content-end px-3 py-2 mt-2"
                    >
                      <button
                        type="submit"
                        class="delon-primary-btn bg-primary-blue border-0 text-white fs-14"
                      >
                        <span>Apply Filter</span>
                      </button>
                    </li>
