---
import Layout from "../layouts/Layout.astro";

import ModalDetailsRemediation from "../components/ui/ModalDetailsRemediation.astro";
---

<Layout title="HRPayHub :: Control Remediation">
  <!-- Main content starts here -->
  <main>
    <!-- First section of Back button and Breadcrumb -->
    <section class="p-4">
      <div class="screenFrame">
        <!-- Back Navigation button and BreadCrumbs -->
        <div class="d-flex gap-5">
          <a
            href="/internal-control-management"
            title="Back to Dashboard"
            class="d-flex gap-2 align-items-center text-decoration-none text-primary-dark"
          >
            <img src="images/png/icons/angle-left.svg" alt="angle-left-back" />
            <span class="fs-16 fw-bold font-avenir-bold">Back</span>
          </a>

          <!-- Actual Breadcrumb here -->
          <div class="d-flex align-items-center gap-2">
            <a
              href="index.html"
              class="fs-14 text-decoration-none text-primary-dark">Dashboard</a
            >
            <img
              src="images/png/icons/angle-right.svg"
              alt="angle-right-back"
            />
            <a
              href="/audit-risk-control-compliance"
              class="fs-14 text-decoration-none text-primary-dark"
              >Audit, Risk, Control & Compliance</a
            >
            <img
              src="images/png/icons/angle-right.svg"
              alt="angle-right-back"
            />
            <a
              href="/internal-control-management"
              class="fs-14 text-decoration-none text-primary-dark"
              >Internal Control Management</a
            >
            <img
              src="images/png/icons/angle-right.svg"
              alt="angle-right-back"
            />
            <span class="fs-16 fw-bold text-primary-blue"
              >Control Remediation
            </span>
          </div>
          <!-- Actual Breadcrumb here -->
        </div>
        <!-- Back Navigation button and BreadCrumbs -->
      </div>
    </section>
    <!-- First section of Back button and Breadcrumb -->

    <!-- First section of Back button and Breadcrumb -->
    <section class="px-lg-5">
      <div class="screenFrame">
        <div class="rounded-4 shadow p-5 vstack gap-3 px-lg-5">
          {/* Page Title */}
          <div class="d-flex justify-content-between gap-3">
            <div>
              <div class="fw-700 fs-22">Control Remediation</div>
              <div class="fs-14">
                Assign, verify, and close actions for control weaknesses.
              </div>
            </div>
          </div>
          {/* Page Title */}

          {/* Page Content Box */}

          <div class="mt-3">
            <p class="fw-600 fs-14 text-primary-blue">
              Click to view more details
            </p>
          </div>

          <!-- Scrollable Table -->
          <div
            class="table-responsive mt-3"
            style="max-height: 600px; overflow: auto;"
          >
            <table class="table table-bordered table-hover">
              <!---- Table head --->
              <thead class="bg-grey text-dark px-4 fw-700 fs-14 text-nowrap">
                <tr>
                  <th class="bg-grey text-darktext-white px-3 fw-700 fs-14"
                    >S/N</th
                  >
                  <th class="bg-grey text-darktext-white px-3 fw-700 fs-14"
                    >Remediation Reference</th
                  >
                  <th class="bg-grey text-darktext-white px-3 fw-700 fs-14"
                    >Linked Deficiency</th
                  >
                  <th class="bg-grey text-darktext-white px-3 fw-700 fs-14"
                    >Action Owner</th
                  >
                  <th class="bg-grey text-dark fw-700 fs-14 px-3 text-left"
                    >Start Date</th
                  >

                  <th class="bg-grey text-dark px-3 fw-700 fs-14 text-left"
                    >Due Date</th
                  >
                  <th class="bg-grey text-dark px-3 fw-700 fs-14 text-left">
                    Progress Percentage</th
                  >
                  <th class="bg-grey text-dark px-3 fw-700 fs-14 text-left">
                    Verified By</th
                  >
                  <th class="bg-grey text-dark px-3 fw-700 fs-14 text-left"
                    >Verification Result</th
                  >
                  <th class="bg-grey text-dark px-3 fw-700 fs-14 text-left"
                    >Review Outcome</th
                  >
                </tr>
              </thead>
              <tbody>
                <!-- Table body and Row -->
                <style>
                  .column {
                    min-width: 180px;
                  }
                </style>
                {
                  [
                    {
                      client_name: "CTRL-PAY-01",
                      client_email: "May 2026",
                      phone_no: "23rd Oct, 2025",
                      currency: "FPS-2026-10",
                      pay_terms: "Engineering",
                      status: "Completed",
                      result: "Pass",
                      effective: "Effective",
                      out_bal: "Quarterly",
                      notes: "Lorem Ipsum...",
                      modalId: "hiredModal",
                    },
                    {
                      client_name: "CTRL-PAY-01",
                      client_email: "May 2026",
                      phone_no: "23rd Oct, 2025",
                      currency: "FPS-2026-10",
                      pay_terms: "Cash",
                      status: "Completed",
                      result: "Pass",
                      effective: "Effective",
                      out_bal: "Quarterly",
                      notes: "Lorem Ipsum...",
                      modalId: "hiredModal",
                    },
                    {
                      client_name: "CTRL-PAY-01",
                      client_email: "May 2026",
                      phone_no: "23rd Oct, 2025",
                      currency: "FPS-2026-10",
                      pay_terms: "POS",
                      status: "Closed",
                      result: "Pass",
                      effective: "Failed",
                      out_bal: "Quarterly",
                      notes: "Lorem Ipsum...",
                      modalId: "newModal",
                    },
                    {
                      client_name: "CTRL-PAY-01",
                      client_email: "May 2026",
                      phone_no: "23rd Oct, 2025",
                      currency: "FPS-2026-10",
                      pay_terms: "Engineering",
                      status: "Closed",
                      result: "Pass",
                      effective: "Failed",
                      out_bal: "Quarterly",
                      notes: "Lorem Ipsum...",
                      modalId: "offeredModal",
                    },
                    {
                      client_name: "CTRL-PAY-01",
                      client_email: "May 2026",
                      phone_no: "23rd Oct, 2025",
                      currency: "FPS-2026-10",
                      pay_terms: "Engineering",
                      status: "Open",
                      result: "Failed",
                      effective: "Ineffective",
                      out_bal: "Quarterly",
                      notes: "Lorem Ipsum...",
                      modalId: "rejectedModal",
                    },

                    {
                      client_name: "CTRL-PAY-01",
                      client_email: "May 2026",
                      phone_no: "23rd Oct, 2025",
                      currency: "FPS-2026-10",
                      pay_terms: "Engineering",
                      status: "Draft",
                      result: "Failed",
                      effective: "Ineffective",
                      out_bal: "Quarterly",
                      notes: "Lorem Ipsum...",
                      modalId: "rejectedModal",
                    },
                  ].map((ele, index) => (
                    <tr class="fs-88">
                      <td class="fs-14 text-center">
                        <span
                          role="button"
                          data-bs-toggle="modal"
                          data-bs-target="#myModal"
                          data-title="Details"
                        >
                          {index + 1}
                        </span>
                      </td>

                      <td class="fs-14 px-3 text-left column text-nowrap">
                        <span
                          role="button"
                          data-bs-toggle="modal"
                          data-bs-target="#myModal"
                          data-title="Details"
                        >
                          {ele.client_name}
                        </span>
                      </td>
                      <td class="fs-14 text-nowrap px-3 text-left column">
                        <span
                          role="button"
                          data-bs-toggle="modal"
                          data-bs-target="#myModal"
                          data-title="Details"
                        >
                          {ele.client_email}
                        </span>
                      </td>
                      <td class="fs-14 px-3 text-left column">
                        <span
                          role="button"
                          data-bs-toggle="modal"
                          data-bs-target="#myModal"
                          data-title="Details"
                        >
                          {ele.currency}
                        </span>
                      </td>

                      <td class="fs-14 px-3 text-left column">
                        <span
                          role="button"
                          data-bs-toggle="modal"
                          data-bs-target="#myModal"
                          data-title="Details"
                        >
                          {ele.notes}
                        </span>
                      </td>

                      <td class="fs-14 px-3 text-left column">
                        {
                          <span
                            role="button"
                            data-bs-toggle="modal"
                            data-bs-target="#myModal"
                            data-title="Details"
                          >
                            {ele.notes}
                          </span>
                        }
                      </td>

                      <td class="fs-14 px-3 text-left column">
                        <span
                          role="button"
                          data-bs-toggle="modal"
                          data-bs-target="#myModal"
                          data-title="Details"
                        >
                          {ele.notes}
                        </span>
                      </td>
                      <td class="fs-14 px-3 text-left column">
                        <span
                          role="button"
                          data-bs-toggle="modal"
                          data-bs-target="#myModal"
                          data-title="Details"
                        >
                          {ele.notes}
                        </span>
                      </td>

                      <td
                        class="fs-14 px-3 text-left column fw-700"
                        style={`color: ${
                          ele.effective === "Effective"
                            ? "#186D00"
                            : ele.effective === "Ineffective"
                              ? "#FD0000"
                              : ele.effective === "Failed"
                                ? "#969103"
                                : "#888585"
                        };`}
                      >
                        <span
                          class="fw-700 border border-1 rounded-3 p-2 py-1 fs-12"
                          style={`background-color: ${
                            ele.effective === "Effective"
                              ? "#E9FFE2"
                              : ele.effective === "Ineffective"
                                ? "#FFF5F5"
                                : ele.effective === "Failed"
                                  ? "#FFFFF2"
                                  : "inherit"
                          }; height: fit-content`}
                          role="button"
                          data-bs-toggle="modal"
                          data-bs-target="#myModal"
                          data-title="Details"
                        >
                          {ele.effective}
                        </span>
                      </td>
                      <td
                        class="fs-14 px-3 text-left column fw-700"
                        style={`color: ${
                          ele.status === "Completed"
                            ? "#186D00"
                            : ele.status === "Closed"
                              ? "#FD0000"
                              : ele.status === "Open"
                                ? "#969103"
                                : "#888585"
                        };`}
                      >
                        <span
                          class="fw-700 border border-1 rounded-3 p-2 py-1 fs-12"
                          style={`background-color: ${
                            ele.status === "Completed"
                              ? "#E9FFE2"
                              : ele.status === "Closed"
                                ? "#FFF5F5"
                                : ele.status === "Open"
                                  ? "#FFFFF2"
                                  : "inherit"
                          }; height: fit-content`}
                          role="button"
                          data-bs-toggle="modal"
                          data-bs-target="#myModal"
                          data-title="Details"
                        >
                          {ele.status}
                        </span>
                      </td>
                    </tr>
                  ))
                }

                <!-- Repeat for more employees -->
              </tbody>
            </table>
          </div>

          <!-- Pagination Row -->
          <div
            class="d-flex justify-content-between align-items-center m-2 flex-wrap gap-3 pt-3"
          >
            <!-- Left: Pagination Text -->
            <div class="fs-14 text-muted">
              Showing <strong>1–20</strong> of <strong>1000</strong>
            </div>

            <!-- Right: Go to Page + Pagination -->
            <div class="d-flex align-items-center gap-3 flex-wrap">
              <!-- Go to Page -->
              <form class="d-flex align-items-center gap-2">
                <label for="gotoPage" class="fs-14 mb-0">Go to page?</label>
                <input
                  type="number"
                  min="1"
                  max="100"
                  id="gotoPage"
                  class="form-control form-control-sm"
                  style="width: 60px;"
                  placeholder="—"
                />
              </form>

              <!-- Page Navigation -->

              <nav>
                <ul class="pagination pagination-sm mb-0 text-primary-blue">
                  <li class="page-item">
                    <a
                      class="page-link text-primary-blue px-2"
                      href="#"
                      aria-label="Previous"
                    >
                      &lsaquo;
                    </a>
                  </li>
                  <li class="page-item">
                    <a class="page-link text-primary-blue" href="#">1</a>
                  </li>
                  <li class="page-item active" aria-current="page">
                    <span class="page-link">2</span>
                  </li>
                  <li class="page-item">
                    <a class="page-link text-primary-blue" href="#">3</a>
                  </li>
                  <li class="page-item disabled">
                    <span class="page-link text-primary-blue">...</span>
                  </li>
                  <li class="page-item">
                    <a class="page-link text-primary-blue" href="#">100</a>
                  </li>
                  <li class="page-item">
                    <a class="page-link hello" href="#" aria-label="Next">
                      &rsaquo;
                    </a>
                  </li>
                </ul>
              </nav>
            </div>
          </div>

          <!---- Pagination ---->
          {/* Page Content Box */}
        </div>
      </div>
    </section>

    <ModalDetailsRemediation
      modalId="myModal"
      title={"Details"}
      inputPlace="Details"
    />
  </main>
</Layout>

<!-- Main content ends here -->

<script></script>
