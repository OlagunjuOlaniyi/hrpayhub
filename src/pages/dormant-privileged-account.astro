---
import Layout from "../layouts/Layout.astro";

import ModalAddNew from "../components/ui/ModalAddNew.astro";
import UnauthorisedModal from "../components/ui/UnauthorisedModal.astro";
---

<Layout title="HRPayHub :: Access Configuration">
  <!-- Main content starts here -->
  <main>
    <!-- First section of Back button and Breadcrumb -->
    <section class="p-4">
      <div class="screenFrame">
        <!-- Back Navigation button and BreadCrumbs -->
        <div class="d-flex gap-5">
          <a
            href="/findings-and-issues"
            title="Back to Dashboard"
            class="d-flex gap-2 align-items-center text-decoration-none text-primary-dark"
          >
            <img src="images/png/icons/angle-left.svg" alt="angle-left-back" />
            <span class="fs-16 fw-bold font-avenir-bold">Back</span>
          </a>

          <!-- Actual Breadcrumb here -->
          <div class="d-flex align-items-center gap-2">
            <a
              href="index.html"
              class="fs-14 text-decoration-none text-primary-dark">Dashboard</a
            >
            <img
              src="images/png/icons/angle-right.svg"
              alt="angle-right-back"
            />
            <a
              href="/audit-risk-control-compliance"
              class="fs-14 text-decoration-none text-primary-dark"
              >Audit, Risk, Control & Compliance</a
            >
            <img
              src="images/png/icons/angle-right.svg"
              alt="angle-right-back"
            />
            <a
              href="/findings-and-issues"
              class="fs-14 text-decoration-none text-primary-dark"
              >Findings & Issues</a
            >

            <img
              src="images/png/icons/angle-right.svg"
              alt="angle-right-back"
            />
            <span class="fs-16 fw-bold text-primary-blue"
              >Dormant privileged accounts not disabled
            </span>
          </div>
          <!-- Actual Breadcrumb here -->
        </div>
        <!-- Back Navigation button and BreadCrumbs -->
      </div>
    </section>
    <!-- First section of Back button and Breadcrumb -->

    <!-- First section of Back button and Breadcrumb -->
    <section class="px-lg-5">
      <div class="screenFrame">
        <div class="rounded-4 shadow p-5 vstack gap-3 px-lg-5">
          {/* Page Title */}
          <div
            class="d-flex justify-content-between gap-3 mx-auto"
            style="width: 70%;"
          >
            <div>
              <div class="fw-700 fs-22">
                Dormant privileged accounts not disabled
              </div>
              <div class="fs-14">F-001 · Audit AP-2025-Q2-02 · Risk R-002</div>
              <div class="d-flex gap-3 mt-2">
                <span
                  class="fw-700 rounded-3 p-2 py-1 fs-12"
                  style="background-color: #FFF5F5; color: #FD0000; border: 1px solid red; height: fit-content"
                  role="button">Critical</span
                >
                <span
                  class="fw-700 rounded-3 p-2 py-1 fs-12"
                  style="background-color: #2271B633; color: #2271B6; border: 1px solid #2271B6; height: fit-content"
                  role="button">In Progress</span
                >
                <span
                  class="fw-700 rounded-3 p-2 py-1 fs-12"
                  style="background-color: #FFF5F5; color: #FD0000; border: 1px solid red; height: fit-content"
                  role="button">Repeat Finding</span
                >
              </div>
            </div>
          </div>

          {/* Page Title */}

          {/* Page Content Box */}

          <div class="mx-auto mt-4" style="width: 70%;">
            <div class="rounded-4 border w-100 p-4">
              <div class="d-flex justify-content-between">
                <div class="w-50">
                  <span class="fs-16 fw-700">Condition</span>
                  <p class="fs-14 mt-2">
                    7 of 88 privileged accounts had no login activity for >90
                    days yet remained enabled.
                  </p>
                </div>
                <div class="w-50">
                  <span class="fs-16 fw-700">Criteria</span>
                  <p class="fs-14 mt-2">
                    ISO 27001 A.9.2.6 requires timely removal of access rights.
                  </p>
                </div>
              </div>
              <div class="d-flex justify-content-between">
                <div class="w-50">
                  <span class="fs-16 fw-700">Condition</span>
                  <p class="fs-14 mt-2">
                    7 of 88 privileged accounts had no login activity for >90
                    days yet remained enabled.
                  </p>
                </div>
                <div class="w-50">
                  <span class="fs-16 fw-700">Effect</span>
                  <p class="fs-14 mt-2">
                    ISO 27001 A.9.2.6 requires timely removal of access rights.
                  </p>
                </div>
              </div>
              <div class="d-flex justify-content-between">
                <div class="w-50">
                  <span class="fs-16 fw-700">Recommendation</span>
                  <p class="fs-14 mt-2">
                    Automate revocation after 30 days of inactivity.
                  </p>
                </div>
                <div class="w-50">
                  <span class="fs-16 fw-700">Suggested Action</span>
                  <p class="fs-14 mt-2">
                    Implement Okta lifecycle policy to auto-disable accounts
                    after 30 days inactivity.
                  </p>
                </div>
              </div>

              <div class="d-flex justify-content-between gap-4 mt-3">
                <div class="rounded-4 p-3 border w-100">
                  <div class="">
                    <p class="fs-14">Responsible</p>
                    <span class="fs-16 fw-700 mt-1">Tunde Bello</span>
                  </div>
                </div>
                <div class="rounded-4 p-3 border w-100">
                  <div class="">
                    <p class="fs-14">Due</p>
                    <span class="fs-16 fw-700 mt-1">2025-07-15</span>
                  </div>
                </div>
                <div class="rounded-4 p-3 border w-100">
                  <div class="">
                    <p class="fs-14">Root Cause</p>
                    <span class="fs-16 fw-700 mt-1"
                      >Manual revocation process with no SLA</span
                    >
                  </div>
                </div>
              </div>
            </div>

            <div class="d-flex justify-content-between gap-4 mt-4">
              <div class="rounded-4 p-3 border w-100">
                <div class="">
                  <p class="fs-14">Linked Audit</p>
                  <span class="fs-16 fw-700 mt-1">AP-2025-Q2-02</span>
                </div>
              </div>
              <div class="rounded-4 p-3 border w-100">
                <div class="">
                  <p class="fs-14">Linked Risk</p>
                  <span class="fs-16 fw-700 mt-1">R-002</span>
                </div>
              </div>
              <div class="rounded-4 p-3 border w-100">
                <div class="">
                  <p class="fs-14">Linked Control</p>
                  <span class="fs-16 fw-700 mt-1">C-002</span>
                </div>
              </div>
            </div>

            <div class="d-flex justify-content-between mt-5">
              <span class="fs-16 fw-700">Management Response</span>
              <button
                type="button"
                data-bs-toggle="modal"
                data-bs-target="#unauthorisedModal"
                data-title="New Control"
                class="delon-primary-btn bg-primary-blue border-0 text-white fw-bold fs-14 expense_button"
              >
                <span>Respond</span>
              </button>
            </div>

            <div class="rounded-4 border w-100 p-4 mt-4">
              <div class="d-flex justify-content-between mt-4">
                <div class="w-50">
                  <span class="fs-16 fw-700">Responsible</span>
                  <p class="fs-14 mt-2">Tunde Bello</p>
                </div>
                <div class="w-50">
                  <span class="fs-16 fw-700">Target Date</span>
                  <p class="fs-14 mt-2">2025-07-15</p>
                </div>
              </div>
              <div class="d-flex justify-content-between mt-4">
                <div class="w-50">
                  <span class="fs-16 fw-700">Response</span>
                  <p class="fs-14 mt-2">
                    Agreed. Lifecycle policy already in design.
                  </p>
                </div>
                <div class="w-50">
                  <span class="fs-16 fw-700">Agreed Action</span>
                  <p class="fs-14 mt-2">Deploy Okta lifecycle policy</p>
                </div>
              </div>
              <div class="d-flex justify-content-between mt-4">
                <div class="w-50">
                  <span class="fs-16 fw-700">Evidence</span>
                  <p class="fs-14 mt-2">okta-policy-draft.pdf</p>
                </div>
                <div class="w-50">
                  <span class="fs-16 fw-700">Reviewer Comment</span>
                  <p class="fs-14 mt-2">Patricia Moore: Approved.</p>
                </div>
              </div>

              <div class="d-flex justify-content-start gap-4 mt-4">
                <button
                  type="button"
                  class="btn rounded-3 fs-14"
                  style="color: red; border: 1px solid red"
                >
                  No, Reject
                </button>
                <button
                  type="button"
                  class="btn text-white bg-primary-blue fs-14"
                >
                  Yes, Approve
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <ModalAddNew
      modalId="myModal"
      title={"Assign Roles"}
      inputPlace="Assign Roles"
    />
    <UnauthorisedModal
      modalId="unauthorisedModal"
      title={"New Control"}
      inputPlace="New Control"
    />
  </main>

  <!-- Main content ends here -->

  <script></script>
</Layout>
