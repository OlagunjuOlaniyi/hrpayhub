---
import Layout from "../layouts/Layout.astro";
---

<Layout title="HRPayHub :: Pension Remittance">
  <!-- Main content starts here -->
  <main>
    <!-- First section of Back button and Breadcrumb -->
    <section class="p-4">
      <div class="screenFrame">
        <!-- Back Navigation button and BreadCrumbs -->
        <div class="d-flex gap-5">
          <a
            href="index.html"
            title="Back to Dashboard"
            class="d-flex gap-2 align-items-center text-decoration-none text-primary-dark"
          >
            <img src="images/png/icons/angle-left.svg" alt="angle-left-back" />
            <span class="fs-16 fw-bold font-avenir-bold">Back</span>
          </a>

          <!-- Actual Breadcrumb here -->
          <div class="d-flex align-items-center gap-2">
            <a
              href="index.html"
              class="fs-14 text-decoration-none text-primary-dark">Dashboard</a
            >
            <img
              src="images/png/icons/angle-right.svg"
              alt="angle-right-back"
            />
            <span class="fs-16 fw-bold text-primary-blue"
              >Pension Remittance</span
            >
          </div>
          <!-- Actual Breadcrumb here -->
        </div>
        <!-- Back Navigation button and BreadCrumbs -->
      </div>
    </section>
    <!-- First section of Back button and Breadcrumb -->

    <!-- First section of Back button and Breadcrumb -->
    <section class="px-4">
      <div class="screenFrame">
        <div class="rounded-4 shadow p-4 vstack gap-5 px-5">
          {/* Page Title */}
          <div class="vstack gap-2">
            <div class="d-flex gap-3 align-items-center">
              <img
                src="images/png/icons/appraisal.svg"
                alt="receipt-minus-icon"
                width="30px"
                height="30px"
              />
              <span
                class="text-primary-blue font-ubuntu-bold fs-24 inline-block"
                >Pension Remittance - Admin/HR Module
              </span>
            </div>
            <div class="fw-bold">
              Generate, validate, pay, track, and confirm employee pension
              remittances.
            </div>
          </div>
          {/* Page Title */}

          {/* Page Content Box */}
          <div class="row payslip-grid-gap mb-5">
            {
              [
                {
                  title: "Pension Dashboard",
                  desc: "Monitor pension schedules, validations, payments, remittances, confirmations, and failed records.",
                  url: "/pension-dashboard",
                },

                {
                  title: "Pension Schedule Generation",
                  desc: "Generate monthly pension schedules from approved payroll records.",
                  url: "/pension-schedule-generation",
                },
                {
                  title: "Pension Remittance Processing",
                  desc: "Submit validated pension schedules and process pension remittance/payment through the integrated API.",
                  url: "/pension-remittance-processing",
                },
              ].map((ele) => (
                <div
                  class="col-4 p-2 payslip-card-panel"
                  style="width: 350px;"
                  role="button"
                  title={ele.title}
                  data-url={ele.url}
                >
                  <div
                    class="shadow p-3 px-3 rounded-3 d-flex flex-column align-items-center justify-content-start gap-3 text-center"
                    style="height: 198px"
                  >
                    <div class=" gap-2 d-flex flex-column align-items-center">
                      <img
                        src="images/png/icons/appraisal.svg"
                        alt="receipt-minus-icon"
                        width="30px"
                        height="30px"
                      />
                      <div class="fw-bold fs-18 font-ubuntu-bold text-primary-blue">
                        {ele.title}
                      </div>
                    </div>

                    <div
                      class="fw-600 fs-16"
                      style="width: 98%; margin: 0 auto;"
                    >
                      {ele.desc}
