---
import Layout from "../layouts/Layout.astro";

import ModalAddNew from "../components/ui/ModalAddNew.astro";
import ApproveAudit from "../components/ui/ApproveAudit.astro";
---

<Layout title="HRPayHub :: Risk-Based Audit Planning">
  <!-- Main content starts here -->
  <main>
    <!-- First section of Back button and Breadcrumb -->
    <section class="p-4">
      <div class="screenFrame">
        <!-- Back Navigation button and BreadCrumbs -->
        <div class="d-flex gap-5">
          <a
            href="/audit-risk-control-compliance"
            title="Back to Dashboard"
            class="d-flex gap-2 align-items-center text-decoration-none text-primary-dark"
          >
            <img src="images/png/icons/angle-left.svg" alt="angle-left-back" />
            <span class="fs-16 fw-bold font-avenir-bold">Back</span>
          </a>

          <!-- Actual Breadcrumb here -->
          <div class="d-flex align-items-center gap-2">
            <a
              href="index.html"
              class="fs-14 text-decoration-none text-primary-dark">Dashboard</a
            >
            <img
              src="images/png/icons/angle-right.svg"
              alt="angle-right-back"
            />
            <a
              href="/audit-risk-control-compliance"
              class="fs-14 text-decoration-none text-primary-dark"
              >Audit, Risk, Control & Compliance</a
            >

            <img
              src="images/png/icons/angle-right.svg"
              alt="angle-right-back"
            />
            <span class="fs-16 fw-bold text-primary-blue"
              >Risk-Based Audit Planning
            </span>
          </div>
          <!-- Actual Breadcrumb here -->
        </div>
        <!-- Back Navigation button and BreadCrumbs -->
      </div>
    </section>
    <!-- First section of Back button and Breadcrumb -->

    <!-- First section of Back button and Breadcrumb -->
    <section class="px-lg-5">
      <div class="screenFrame">
        <div class="rounded-4 shadow p-5 vstack gap-3 px-lg-5">
          {/* Page Title */}
          <div class="d-flex justify-content-between gap-3">
            <div>
              <div class="fw-700 fs-22">Risk-Based Audit Planning</div>
              <div class="fs-14">Plan audits based on risk and priority</div>
            </div>

            <!-- Others -->
            <div class="responsive gap-4 align-items-center">
              <div class="d-flex justify-content-end">
                <button
                  class="btn bg-primary-blue d-flex align-items-center text-white fs-14 py-2"
                  type="button"
                  data-bs-toggle="modal"
                  data-bs-target="#myModal"
                  data-title="Plan Audit"
                  ><span class="fw-700 fs-14">+</span><span
                    class="ms-2 text-nowrap">Plan Audit</span
                  >
                </button>
              </div>

              <!---- End of Others ---->
            </div>
          </div>
          {/* Page Title */}

          {/* Page Content Box */}
          <div class="mt-3">
            <p class="fw-600 fs-14 text-primary-blue">
              Click to approve pending audit planning
            </p>
          </div>

          <!-- Scrollable Table -->
          <div
            class="table-responsive mt-3"
            style="max-height: 600px; overflow: auto;"
          >
            <table class="table table-bordered table-hover">
              <!---- Table head --->
              <thead class="bg-grey text-dark px-4 fw-700 fs-14 text-nowrap">
                <tr>
                  <th class="bg-grey text-darktext-white px-3 fw-700 fs-14"
                    >S/N</th
                  >

                  <th class="bg-grey text-darktext-white px-3 fw-700 fs-14"
                    >Name</th
                  >
                  <th class="bg-grey text-darktext-white px-3 fw-700 fs-14"
                    >Linked Risk</th
                  >
                  <th class="bg-grey text-darktext-white px-3 fw-700 fs-14"
                    >Linked Audit Universe</th
                  >
                  <th
                    class="bg-grey text-dark fw-700 fs-14 px-3 text-left"
                    style="min-width: 200px;">Risk Rating</th
                  >

                  <th class="bg-grey text-dark px-3 fw-700 fs-14 text-left"
                    >Audit Priority</th
                  >
                  <th class="bg-grey text-dark px-3 fw-700 fs-14 text-left"
                    >Planned Quarter</th
                  >
                  <th class="bg-grey text-dark px-3 fw-700 fs-14 text-left"
                    >Assigned Auditor</th
                  >
                  <th class="bg-grey text-dark px-3 fw-700 fs-14 text-left"
                    >Audit Manager</th
                  >
                  <th class="bg-grey text-dark px-3 fw-700 fs-14 text-left"
                    >Estimated Audit Hours</th
                  >
                  <th class="bg-grey text-dark px-3 fw-700 fs-14 text-left"
                    >Dates</th
                  >
                  <th class="bg-grey text-dark px-3 fw-700 fs-14 text-left"
                    >Status</th
                  >
                </tr>
              </thead>
              <tbody>
                <!-- Table body and Row -->
                <style>
                  .column {
                    min-width: 180px;
                  }
                </style>
                {
                  [
                    {
                      client_name: "Payroll Processing",
                      client_email: "May 2026",
                      phone_no: "2025-02-01 → 2025-02-28",
                      currency: "FPS-2026-10",
                      pay_terms: "Engineering",
                      status: "Low",
                      out_bal: "Quarterly",
                      status2: "Completed",
                      notes: "Lorem Ipsum...",
                      modalId: "hiredModal",
                    },
                    {
                      client_name: "Payroll Processing",
                      client_email: "May 2026",
                      phone_no: "2025-02-01 → 2025-02-28",
                      currency: "FPS-2026-10",
                      pay_terms: "Cash",
                      status: "Low",
                      out_bal: "Quarterly",
                      status2: "Completed",
                      notes: "Lorem Ipsum...",
                      modalId: "hiredModal",
                    },
                    {
                      client_name: "Payroll Processing",
                      client_email: "May 2026",
                      phone_no: "2025-02-01 → 2025-02-28",
                      currency: "FPS-2026-10",
                      pay_terms: "POS",
                      status: "Medium",
                      status2: "In Progress",
                      out_bal: "Quarterly",
                      notes: "Lorem Ipsum...",
                      modalId: "newModal",
                    },
                    {
                      client_name: "Payroll Processing",
                      client_email: "May 2026",
                      phone_no: "2025-02-01 → 2025-02-28",
                      currency: "FPS-2026-10",
                      pay_terms: "Engineering",
                      status: "Medium",
                      status2: "In Progress",
                      out_bal: "Quarterly",
                      notes: "Lorem Ipsum...",
                      modalId: "offeredModal",
                    },
                    {
                      client_name: "Payroll Processing",
                      client_email: "May 2026",
                      phone_no: "2025-02-01 → 2025-02-28",
                      currency: "FPS-2026-10",
                      pay_terms: "Engineering",
                      status: "High",
                      status2: "Pending",
                      out_bal: "Quarterly",
                      notes: "Lorem Ipsum...",
                      modalId: "rejectedModal",
                    },

                    {
                      client_name: "Payroll Processing",
                      client_email: "May 2026",
                      phone_no: "2025-02-01 → 2025-02-28",
                      currency: "FPS-2026-10",
                      pay_terms: "Engineering",
                      status: "High",
                      status2: "Pending",
                      out_bal: "Quarterly",
                      notes: "Lorem Ipsum...",
                      modalId: "rejectedModal",
                    },
                  ].map((ele, index) => (
                    <tr class="fs-88">
                      <td class="fs-14 text-center">
                        {ele.status2 === "Pending" ? (
                          <span
                            role="button"
                            data-bs-toggle="modal"
                            data-bs-target="#approveModal"
                            data-title="Details"
                          >
                            {index + 1}
                          </span>
                        ) : (
                          <span>{index + 1}</span>
                        )}
                      </td>

                      <td class="fs-14 px-3 text-left column text-nowrap">
                        {ele.status2 === "Pending" ? (
                          <span
                            role="button"
                            data-bs-toggle="modal"
                            data-bs-target="#approveModal"
                            data-title="Details"
                          >
                            <span class="fw-700">{ele.client_name}</span>
                            <br />

                            <span class="fs-12">AU-001 · HRPayHub Payroll</span>
                          </span>
                        ) : (
                          <>
                            <span class="fw-700">{ele.client_name}</span>
                            <br />

                            <span class="fs-12">AU-001 · HRPayHub Payroll</span>
                          </>
                        )}
                      </td>
                      <td class="fs-14 text-nowrap px-3 text-left column">
                        {ele.status2 === "Pending" ? (
                          <span
                            role="button"
                            data-bs-toggle="modal"
                            data-bs-target="#approveModal"
                            data-title="Details"
                          >
                            {ele.client_email}
                          </span>
                        ) : (
                          <span>{ele.client_email}</span>
                        )}
                      </td>
                      <td class="fs-14 px-3 text-left column">
                        {ele.status2 === "Pending" ? (
                          <span
                            role="button"
                            data-bs-toggle="modal"
                            data-bs-target="#approveModal"
                            data-title="Details"
                          >
                            {ele.currency}
                          </span>
                        ) : (
                          <span>{ele.currency}</span>
                        )}
                      </td>

                      <td
                        class="fs-14 px-3 text-left column fw-700"
                        style={`color: ${
                          ele.status === "Low"
                            ? "#186D00"
                            : ele.status === "High"
                              ? "#FD0000"
                              : ele.status === "Medium"
                                ? "#969103"
                                : "#888585"
                        };`}
                      >
                        {ele.status2 === "Pending" ? (
                          <span
                            class="fw-700 border border-1 rounded-3 p-2 py-1 fs-12"
                            style={`background-color: ${
                              ele.status === "Low"
                                ? "#E9FFE2"
                                : ele.status === "High"
                                  ? "#FFF5F5"
                                  : ele.status === "Medium"
                                    ? "#FFFFF2"
                                    : "inherit"
                            }; height: fit-content`}
                            role="button"
                            data-bs-toggle="modal"
                            data-bs-target="#approveModal"
                            data-title="Details"
                          >
                            {ele.status}
                          </span>
                        ) : (
                          <span
                            class="fw-700 border border-1 rounded-3 p-2 py-1 fs-12"
                            style={`background-color: ${
                              ele.status === "Low"
                                ? "#E9FFE2"
                                : ele.status === "High"
                                  ? "#FFF5F5"
                                  : ele.status === "Medium"
                                    ? "#FFFFF2"
                                    : "inherit"
                            }; height: fit-content`}
                            role="button"
                          >
                            {ele.status}
                          </span>
                        )}
                      </td>
                      <td class="fs-14 px-3 text-left column">
                        {ele.status2 === "Pending" ? (
                          <span
                            role="button"
                            data-bs-toggle="modal"
                            data-bs-target="#approveModal"
                            data-title="Details"
                          >
                            {ele.notes}
                          </span>
                        ) : (
                          <span>{ele.notes}</span>
                        )}
                      </td>

                      <td class="fs-14 px-3 text-left column text-nowrap">
                        {ele.status2 === "Pending" ? (
                          <span
                            role="button"
                            data-bs-toggle="modal"
                            data-bs-target="#approveModal"
                            data-title="Details"
                          >
                            {ele.phone_no}
                          </span>
                        ) : (
                          <span>{ele.phone_no}</span>
                        )}
                      </td>
                      <td class="fs-14 px-3 text-left column">
                        {ele.status2 === "Pending" ? (
                          <span
                            role="button"
                            data-bs-toggle="modal"
                            data-bs-target="#approveModal"
                            data-title="Details"
                          >
                            {ele.out_bal}
                          </span>
                        ) : (
                          <span>{ele.out_bal}</span>
                        )}
                      </td>
                      <td class="fs-14 px-3 text-left column">
                        {ele.status2 === "Pending" ? (
                          <span
                            role="button"
                            data-bs-toggle="modal"
                            data-bs-target="#approveModal"
                            data-title="Details"
                          >
                            {ele.notes}
                          </span>
                        ) : (
                          <span>{ele.notes}</span>
                        )}
                      </td>
                      <td class="fs-14 px-3 text-left column">
                        {ele.status2 === "Pending" ? (
                          <span
                            role="button"
                            data-bs-toggle="modal"
                            data-bs-target="#approveModal"
                            data-title="Details"
                          >
                            {ele.notes}
                          </span>
                        ) : (
                          <span>{ele.notes}</span>
                        )}
                      </td>
                      <td class="fs-14 px-3 text-left column text-nowrap">
                        {ele.status2 === "Pending" ? (
                          <span
                            role="button"
                            data-bs-toggle="modal"
                            data-bs-target="#approveModal"
                            data-title="Details"
                          >
                            {ele.phone_no}
                          </span>
                        ) : (
                          <span>{ele.phone_no}</span>
                        )}
                      </td>
                      <td
                        class="fs-14 px-3 text-left column fw-700"
                        style={`color: ${
                          ele.status2 === "Completed"
                            ? "#186D00"
                            : ele.status2 === "Pendin"
                              ? "#FD0000"
                              : ele.status2 === "In Progress"
                                ? "#969103"
                                : "#888585"
                        };`}
                      >
                        {ele.status2 === "Pending" ? (
                          <span
                            class="fw-700 border border-1 rounded-3 p-2 py-1 fs-12"
                            style={`background-color: ${
                              ele.status2 === "Completed"
                                ? "#E9FFE2"
                                : ele.status2 === "Pendin"
                                  ? "#FFF5F5"
                                  : ele.status2 === "In Progress"
                                    ? "#FFFFF2"
                                    : "inherit"
                            }; height: fit-content`}
                            role="button"
                            data-bs-toggle="modal"
                            data-bs-target="#approveModal"
                            data-title="Details"
                          >
                            {ele.status2}
                          </span>
                        ) : (
                          <span
                            class="fw-700 border border-1 rounded-3 p-2 py-1 fs-12"
                            style={`background-color: ${
                              ele.status2 === "Completed"
                                ? "#E9FFE2"
                                : ele.status2 === "Pendin"
                                  ? "#FFF5F5"
                                  : ele.status2 === "In Progress"
                                    ? "#FFFFF2"
                                    : "inherit"
                            }; height: fit-content`}
                            role="button"
                          >
                            {ele.status2}
                          </span>
                        )}
                      </td>
                    </tr>
                  ))
                }

                <!-- Repeat for more employees -->
              </tbody>
            </table>
          </div>

          <!-- Pagination Row -->
          <div
            class="d-flex justify-content-between align-items-center m-2 flex-wrap gap-3 pt-3"
          >
            <!-- Left: Pagination Text -->
            <div class="fs-14 text-muted">
              Showing <strong>1–20</strong> of <strong>1000</strong>
            </div>

            <!-- Right: Go to Page + Pagination -->
            <div class="d-flex align-items-center gap-3 flex-wrap">
              <!-- Go to Page -->
              <form class="d-flex align-items-center gap-2">
                <label for="gotoPage" class="fs-14 mb-0">Go to page?</label>
                <input
                  type="number"
                  min="1"
                  max="100"
                  id="gotoPage"
                  class="form-control form-control-sm"
                  style="width: 60px;"
                  placeholder="—"
                />
              </form>

              <!-- Page Navigation -->

              <nav>
                <ul class="pagination pagination-sm mb-0 text-primary-blue">
                  <li class="page-item">
                    <a
                      class="page-link text-primary-blue px-2"
                      href="#"
                      aria-label="Previous"
                    >
                      &lsaquo;
                    </a>
                  </li>
                  <li class="page-item">
                    <a class="page-link text-primary-blue" href="#">1</a>
                  </li>
                  <li class="page-item active" aria-current="page">
                    <span class="page-link">2</span>
                  </li>
                  <li class="page-item">
                    <a class="page-link text-primary-blue" href="#">3</a>
                  </li>
                  <li class="page-item disabled">
                    <span class="page-link text-primary-blue">...</span>
                  </li>
                  <li class="page-item">
                    <a class="page-link text-primary-blue" href="#">100</a>
                  </li>
                  <li class="page-item">
                    <a class="page-link hello" href="#" aria-label="Next">
                      &rsaquo;
                    </a>
                  </li>
                </ul>
              </nav>
            </div>
          </div>

          <!---- Pagination ---->
          {/* Page Content Box */}
        </div>
      </div>
    </section>

    <ModalAddNew
      modalId="myModal"
      title={"Plan Audit"}
      inputPlace="Plan Audit"
    />
    <ApproveAudit
      modalId="approveModal"
      title={"Approve Audit"}
      inputPlace="Approve Audit"
    />
  </main>
</Layout>

<!-- Main content ends here -->

<script></script>
