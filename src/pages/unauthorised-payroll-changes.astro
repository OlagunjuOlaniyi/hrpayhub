                        style="background-color: #FFF5F5; color: #FD0000; height: fit-content"
                        role="button">Critical</span
                      >
                    </div>
                  </div>
                </div>
              </div>

              <div class="w-75 mt-5">
                <div class="fs-14 mb-2">Control Effectiveness</div>
                <div class="fs-16 mb-2 fw-700">70%</div>
                <div class="progress" style="height: 10px;">
                  <div
                    class="progress-bar bg-primary-blue"
                    style="width: 70%; "
                    role="progressbar"
                    aria-valuenow="70"
                    aria-valuemin="0"
                    aria-valuemax="100"
