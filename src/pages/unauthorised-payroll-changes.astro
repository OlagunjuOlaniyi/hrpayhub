              >Unauthorised payroll changes
            </span>
          </div>
          <!-- Actual Breadcrumb here -->
        </div>
        <!-- Back Navigation button and BreadCrumbs -->
      </div>
    </section>
    <!-- First section of Back button and Breadcrumb -->

    <!-- First section of Back button and Breadcrumb -->
    <section class="px-lg-5">
      <div class="screenFrame">
        <div class="rounded-4 shadow p-5 vstack gap-3 px-lg-5">
          {/* Page Title */}
          <div
            class="d-flex justify-content-between gap-3 mx-auto"
            style="width: 70%;"
          >
            <div>
              <div class="fw-700 fs-22">Unauthorised payroll changes</div>
              <div class="fs-14">RSK-PAY-01 · Payroll · Finance Ops</div>
            </div>
          </div>

          {/* Page Title */}

          {/* Page Content Box */}
          <div class="mx-auto mt-4" style="width: 70%;">
            <div class="rounded-4 border w-100 p-4">
              <div class="d-flex justify-content-between">
                <div class="">
                  <span class="fs-16 fw-700">Description</span>
                  <p class="fs-14 mt-2">
                    Risk of unauthorised modification of salary or bank details
                    prior to payroll run.
                  </p>
                </div>
              </div>

              <div class="d-flex justify-content-between gap-4 mt-3">
                <div class="rounded-4 p-3 border w-100">
                  <div class="">
                    <p class="fs-14">Owner</p>
                    <span class="fs-16 fw-700 mt-1">Tunde Bello</span>
                  </div>
                </div>
                <div class="rounded-4 p-3 border w-100">
                  <div class="">
                    <p class="fs-14">Treatment</p>
                    <span class="fs-16 fw-700 mt-1">Reduce</span>
                  </div>
                </div>
                <div class="rounded-4 p-3 border w-100">
                  <div class="">
                    <p class="fs-14">Appetite</p>
                    <span class="fs-16 fw-700 mt-1">Low</span>
                  </div>
                </div>
                <div class="rounded-4 p-3 border w-100">
                  <div class="">
                    <p class="fs-14">Status</p>
                    <span
                      class="fw-700 border border-1 rounded-3 p-2 py-1 fs-12"
