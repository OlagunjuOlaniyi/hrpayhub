                  <span class="fs-16 fw-700">Scoring Breakdown</span>
                </div>
              </div>

              <div class="d-flex justify-content-between gap-4 mt-3">
                <div class="rounded-4 p-3 border w-100">
                  <div class="">
                    <p class="fs-14">Likelihood</p>
                    <span class="fs-16 fw-700 mt-1">4</span>
