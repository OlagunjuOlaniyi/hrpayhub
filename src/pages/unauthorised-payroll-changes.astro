                              {
                                client_name: "	Dual approval for salary changes",
                                client_email: "CTRL-PAY-01",

                                phone_no: "23rd Oct, 2025",
                                currency: "Effective",
                                pay_terms: "Cash",
                                status: "Open",
                                out_bal: "Preventive",
