---
import Layout from "../layouts/Layout.astro";
import PaymentPostModal from "../components/ui/PaymentPostModal.astro";
import RecordPaymentModal from "../components/ui/RecordPaymentModal.astro";
import ModalAddNew from "../components/ui/ModalAddNew.astro";
import DeleteModal from "../components/ui/DeleteModal.astro";
import PendingJobsModal from "../components/ui/PendingJobsModal.astro";
---

<Layout title="HRPayHub :: Payment Approval and Authorization">
  <!-- Main content starts here -->
  <main>
    <!-- First section of Back button and Breadcrumb -->
    <section class="p-4">
      <div class="screenFrame">
        <!-- Back Navigation button and BreadCrumbs -->
        <div class="d-flex gap-5">
          <a
            href="/pension-remittance"
            title="Back to Dashboard"
            class="d-flex gap-2 align-items-center text-decoration-none text-primary-dark"
          >
            <img src="images/png/icons/angle-left.svg" alt="angle-left-back" />
            <span class="fs-16 fw-bold font-avenir-bold">Back</span>
          </a>

          <!-- Actual Breadcrumb here -->
          <div class="d-flex align-items-center gap-2">
            <a
              href="index.html"
              class="fs-14 text-decoration-none text-primary-dark">Dashboard</a
            >
            <img
              src="images/png/icons/angle-right.svg"
              alt="angle-right-back"
            />
            <a
              href="/pension-remittance"
              class="fs-14 text-decoration-none text-primary-dark"
              >Pension Remittance</a
            >

            <img
              src="images/png/icons/angle-right.svg"
              alt="angle-right-back"
            />
            <span class="fs-16 fw-bold text-primary-blue"
              >Payment Approval and Authorization</span
            >
          </div>
          <!-- Actual Breadcrumb here -->
        </div>
        <!-- Back Navigation button and BreadCrumbs -->
      </div>
    </section>
    <!-- First section of Back button and Breadcrumb -->

    <!-- First section of Back button and Breadcrumb -->
    <section class="px-lg-4">
      <div class="screenFrame">
        <div class="rounded-4 shadow p-4 vstack gap-3 px-lg-5">
          {/* Page Title */}
          <div class="vstack gap-3">
            <div>
              <div class="fw-700 fs-22">Payment Approval and Authorization</div>
              <div class="fs-14">
                Support internal approval before pension payment/remittance is
                completed.
              </div>
            </div>
          </div>
          {/* Page Title */}

          {/* Page Content Box */}

          <!-- Nav pills -->
          <div class="d-flex gap-4 mt-4">
            <ul class="nav nav-pills payment_receipt_bg fs-14">
              <li class="nav-item">
                <a
                  class="nav-link active"
                  data-bs-toggle="pill"
                  href="#paymentHistory">Pending</a
                >
              </li>
              <li class="nav-item ms-3">
                <a
                  class="nav-link text-dark"
                  data-bs-toggle="pill"
                  href="#pendingPost"
                  >History
                </a>
              </li>
            </ul>
          </div>

          <!-- Tab panes -->
          <div class="tab-content">
            <div class="tab-pane container active" id="paymentHistory">
              <!-- Scrollable Table -->
              <div
                class="table-responsive mt-3"
                style="max-height: 600px; overflow: auto;"
              >
                <table class="table table-bordered table-hover">
                  <!---- Table head --->
                  <thead
                    class="bg-grey text-dark px-4 fw-700 fs-14 text-nowrap"
                  >
                    <tr>
                      <th class="bg-grey text-darktext-white px-3 fw-700 fs-14"
                        >S/N</th
                      >
                      <th class="bg-grey text-darktext-white px-3 fw-700 fs-14"
                        >Reference</th
                      >
                      <th
                        class="bg-grey text-dark fw-700 fs-14 px-3 text-left"
                        style="min-width: 200px;"
                      >
                        Period</th
                      >

                      <th class="bg-grey text-dark px-3 fw-700 fs-14 text-left"
                        >Total</th
                      >
                      <th class="bg-grey text-dark px-3 fw-700 fs-14 text-left"
                        >Approved By</th
                      >

                      <th class="bg-grey text-dark px-3 fw-700 fs-14 text-left">
                        Status</th
                      >

                      <th
                        class="bg-grey text-dark px-3 fw-700 fs-14 text-status"
                        >Status</th
                      >
                    </tr>
                  </thead>
                  <tbody>
                    <!-- Table body and Row -->
                    <style>
                      .column {
                        min-width: 180px;
                      }
                    </style>
                    {
                      [
                        {
                          client_name: "Adebayo Salami",
                          client_email: "HRP-RCT-2024-55143",
                          phone_no: "23rd Oct, 2025",
                          currency: "23rd Oct, 2025",
                          pay_terms: "POS",
                          status: "Approved",
                          out_bal: "N124,676",
                        },
                        {
                          client_name: "Adebayo Salami",
                          client_email: "HRP-RCT-2024-55143",
                          phone_no: "23rd Oct, 2025",
                          currency: "23rd Oct, 2025",
                          pay_terms: "Bank Transfer",
                          status: "Approved",
                          out_bal: "N124,676",
                        },

                        {
                          client_name: "Adebayo Salami",
                          client_email: "HRP-RCT-2024-55143",
                          phone_no: "23rd Oct, 2025",
                          currency: "23rd Oct, 2025",
                          pay_terms: "Bank Transfer",
                          status: "Approved",
                          out_bal: "N124,676",
                        },
                      ].map((ele, index) => (
                        <tr class="fs-88">
                          <td class="fs-14 text-center">{index + 1}</td>
                          <td class="fs-14 text-nowrap px-3 text-left column">
                            {ele.client_email}
                          </td>
                          <td class="fs-14 px-3 text-left column">
                            {ele.client_email}
                          </td>

                          <td class="fs-14 px-3 text-left column">
                            {ele.currency}
                          </td>
                          <td class="fs-14 px-3 text-left column">
                            {ele.client_name}
                          </td>

                          <td
                            class="fs-14 px-3 text-left column fw-700"
                            style={`color: ${
                              ele.status === "Meets Expectation"
                                ? "#2271B6"
                                : ele.status === "Approved"
                                  ? "#186D00"
                                  : ele.status === "Closed"
                                    ? "#FD0000"
                                    : ele.status === "Pending Approval"
                                      ? "#969103"
                                      : "inherit"
                            };`}
                          >
                            <span
                              class="fw-600 border border-1 rounded-3 p-2 py-1 ms-2 fs-12"
                              style={`background-color: ${
                                ele.status === "Meets Expectation"
                                  ? "#EFF7FF"
                                  : ele.status === "Approved"
                                    ? "#E9FFE2"
                                    : ele.status === "Closed"
                                      ? "#FFF5F5"
                                      : ele.status === "Pending Approval"
                                        ? "#FFFFF2"
                                        : "inherit"
                              }; height: fit-content`}
                              role="button"
                            >
                              {ele.status}
                            </span>
                          </td>

                          <td class="fs-14 px-3 text-left d-flex justify-content-center column">
                            <div class="d-flex ">
                              <button
                                type="button"
                                class="delon-primary-btn bg-primary-blue border-0 text-white fw-bold fs-14 "
                              >
                                <span>Process Payment</span>
                              </button>
                            </div>
                          </td>
                        </tr>
                      ))
                    }

                    <!-- Repeat for more employees -->
                  </tbody>
                </table>
              </div>

              <!---- End of table --->
            </div>

            <!-- Pending post tab -->
            <div class="tab-pane container" id="pendingPost">
              <!-- Scrollable Table -->
              <div
                class="table-responsive mt-3"
                style="max-height: 600px; overflow: auto;"
              >
                <table class="table table-bordered table-hover">
                  <!---- Table head --->
                  <thead
                    class="bg-grey text-dark px-4 fw-700 fs-14 text-nowrap"
                  >
                    <tr>
                      <th class="bg-grey text-left text-dark px-3 fw-700 fs-14"
                        >S/N</th
                      >
                      <th class="bg-grey text-left text-dark px-3 fw-700 fs-14"
                        >Reference</th
                      >
                      <th
                        class="bg-grey text-dark fw-700 fs-14 px-3 text-left"
                        style="min-width: 200px;"
                      >
                        Period</th
                      >

                      <th class="bg-grey text-dark px-3 fw-700 fs-14 text-left"
                        >Total</th
                      >
                      <th class="bg-grey text-dark px-3 fw-700 fs-14 text-left"
                        >Approved By</th
                      >

                      <th class="bg-grey text-dark px-3 fw-700 fs-14 text-left">
                        Status</th
                      >
                      <th class="bg-grey text-dark px-3 fw-700 fs-14 text-left">
                        Payment Processed By</th
                      >
                    </tr>
                  </thead>
                  <tbody>
                    <!-- Table body and Row -->
                    <style>
                      .column {
                        min-width: 180px;
                      }
                    </style>
                    {
                      [
                        {
                          client_name: "HRP-INV-2024-0001",
                          client_email: "HRP-RCT-2024-55143",
                          phone_no: "23rd Oct, 2025",
                          currency: "Lorem Ipsum...",
                          pay_terms: "Bank Transfer",
                          status: "Approved",
                          out_bal: "N124,676",
                          modalId: "awaitingConversion",
                        },
                        {
                          client_name: "HRP-INV-2024-0001",
                          client_email: "HRP-RCT-2024-55143",
                          phone_no: "23rd Oct, 2025",
                          currency: "Lorem Ipsum...",
                          pay_terms: "Cash",
                          status: "Approved",
                          out_bal: "N124,676",
                          modalId: "awaitingConversion",
                        },
                        {
                          client_name: "HRP-INV-2024-0001",
                          client_email: "HRP-RCT-2024-55143",
                          phone_no: "23rd Oct, 2025",
                          currency: "Lorem Ipsum...",
                          pay_terms: "POS",
                          status: "Approved",
                          out_bal: "N124,676",
                          modalId: "awaitingConversion",
                        },
                      ].map((ele, index) => (
                        <tr class="fs-88">
                          <td class="fs-14 text-center">{index + 1}</td>
                          <td class="fs-14 text-nowrap px-3 text-left column">
                            {ele.client_email}
                          </td>
                          <td class="fs-14 px-3 text-left column">
                            {ele.client_name}
                          </td>

                          <td class="fs-14 px-3 text-left column">
                            {ele.pay_terms}
                          </td>
                          <td class="fs-14 px-3 text-left column">
                            {ele.currency}
                          </td>

                          <td
                            class="fs-14 px-3 text-left column fw-700"
                            style={`color: ${
                              ele.status === "Meets Expectation"
                                ? "#2271B6"
                                : ele.status === "Approved"
                                  ? "#186D00"
                                  : ele.status === "Rejected"
                                    ? "#FD0000"
                                    : ele.status === "Awaiting Conversion"
                                      ? "#969103"
                                      : "inherit"
                            };`}
                          >
                            <span
                              class="fw-600 border border-1 rounded-3 p-2 py-1 ms-2 fs-12"
                              style={`background-color: ${
                                ele.status === "Meets Expectation"
                                  ? "#EFF7FF"
                                  : ele.status === "Approved"
                                    ? "#E9FFE2"
                                    : ele.status === "Rejected"
                                      ? "#FFF5F5"
                                      : ele.status === "Awaiting Conversion"
                                        ? "#FFFFF2"
                                        : "inherit"
                              }; height: fit-content`}
                              role="button"
                            >
                              {ele.status}
                            </span>
                          </td>
                          <td class="fs-14 px-3 text-left column">
                            {ele.currency}
                          </td>
                        </tr>
                      ))
                    }

                    <!-- Repeat for more employees -->
                  </tbody>
                </table>
              </div>

              <!---- End of table --->
            </div>
          </div>

          {/* Page Content Box */}
        </div>
      </div>
    </section>

    <ModalAddNew
      modalId="createPosting"
      title={"Create Posting"}
      inputPlace="Create Posting"
    />
    <ModalAddNew
      modalId="editPosting"
      title={"Edit Posting"}
      inputPlace="Create Posting"
    />
    <DeleteModal modalId="deleteModal" title="Job Posting" />
    <PendingJobsModal
      modalId="awaitingConversion"
      title={"Job Requests"}
      inputPlace="Awaiting Conversion"
    />
  </main>
</Layout>

<!-- Main content ends here -->

<script></script>
